[sub_resource type="GDScript" id="GDScript_wajtt"]
script/source = "extends CharacterBody2D


const SPEED = 400.0
const JUMP_VELOCITY = -400.0
var angulo : float = 0
@export var desfase : float = 15
@export var barraSueno : BarraSueno
var reaccion : float = 1
var actual_direction : int

@export var invertido : bool = false
@export var telefono : bool = false
@export var volantazo : bool = false

var volantazoMaxTimer : float = 2
var volantazoTimer : float = volantazoMaxTimer

func _physics_process(delta: float) -> void:
	# Add the gravity.
	#if not is_on_floor():
		#velocity += get_gravity() * delta

	# Handle jump.
	#if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		#velocity.y = JUMP_VELOCITY

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"izquierda\", \"derecha\")
	
	var porcentajeSueno : float = 1.0-barraSueno.getSueno()
	
	# Controles invertidos
	if invertido:
		direction *= -1
		
	# Telefono
	
	# Volantazo
	if volantazo:
		if volantazoTimer > 0:
			volantazoTimer -= delta
			#print(volantazoTimer)
		else:
			# aplicar volantazo
			print(\"volatnazo\")
			velocity.x = [-1,1].pick_random() * SPEED / 4
			
			# reiniciar contador
			volantazoTimer = volantazoMaxTimer
			
		
	
	#print(str(porcentajeSueno))
	if direction == 0:
		angulo = lerp(angulo, (desfase + (35 * (porcentajeSueno))) * velocity.normalized().x,0.1)
	else:
		angulo = lerp(angulo, (desfase + (35 * (porcentajeSueno))) * direction,0.1)
	
	rotation_degrees = angulo
	
	
	
	if direction:
		#velocity.x = direction * SPEED
		velocity.x += direction * (SPEED + (porcentajeSueno * SPEED)) * delta
		#velocity.x = lerp(velocity.x,direction * SPEED,reaccion/2.0)
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED / (10.0 + 90.0 * porcentajeSueno))
		
	velocity.y = 0

	move_and_slide()


func _on_collision(body: Node2D) -> void:
	if body is Obstaculo:
		print(\"choque detectado\")
		body.queue_free()
		barraSueno.hit(0.1)
	pass # Replace with function body.
"

