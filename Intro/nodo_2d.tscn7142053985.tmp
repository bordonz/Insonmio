[sub_resource type="GDScript" id="GDScript_ukvte"]
script/source = "extends ColorRect

@export var max_respiraciones: int = 3 # Cantidad de ciclos antes de parpadear
@export var velocidad_respiracion: float = 2.0
@export var max_blur: float = 4.0

var tiempo: float = 0.0
var contador_ciclos: int = 0
var en_parpadeo: bool = false

func _process(delta: float) -> void:
	if en_parpadeo:
		return

	tiempo += delta * velocidad_respiracion
	
	# Usamos sin() para calcular la onda de respiración
	var onda = (sin(tiempo) + 1.0) * 0.5
	
	# Detectamos cuando la onda llega al punto mínimo (comienza un nuevo ciclo)
	if sin(tiempo - delta * velocidad_respiracion) < -0.99 and sin(tiempo) >= -0.99:
		contador_ciclos += 1
		if contador_ciclos >= max_respiraciones:
			ejecutar_parpadeo()
			return

	# Enviamos la intensidad del blur al shader
	material.set_shader_parameter(\"blur_intensidad\", onda * max_blur)

func ejecutar_parpadeo() -> void:
	en_parpadeo = true
	contador_ciclos = 0
	
	var tween = create_tween()
	# 1. Cierra los ojos (oscuridad total + blur alto) rápido
	tween.tween_property(material, \"shader_parameter/oscuridad\", 1.0, 0.2)
	tween.parallel().tween_property(material, \"shader_parameter/blur_intensidad\", max_blur, 0.2)
	
	# 2. Mantiene los ojos cerrados un instante
	tween.tween_interval(0.3)
	
	# 3. Abre los ojos suavemente
	tween.tween_property(material, \"shader_parameter/oscuridad\", 0.0, 0.4)
	
	# Al finalizar la animación del parpadeo, reiniciamos el ciclo
	tween.tween_callback(func(): 
		tiempo = 0.0
		en_parpadeo = false
	)
"

